# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project > Settings > Environment Variables).
# .env.local is git-ignored. Never commit real keys.

# --- Public links (safe to expose; NEXT_PUBLIC_ means the browser can see them) ---
NEXT_PUBLIC_SITE_URL=https://stickinhistory.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LATEST_EPISODE_URL=
NEXT_PUBLIC_PATREON_URL=
# Your Fourthwall shop's address, e.g. https://stick-in-history-shop.fourthwall.com
NEXT_PUBLIC_SHOP_URL=

# --- Fourthwall products (optional; without it the site shows the products in src/config/site.ts) ---
# Fourthwall admin > Settings > For Developers > Storefront token (starts with ptkn_)
FOURTHWALL_STOREFRONT_TOKEN=
# Collection to show. "all" is every public product.
FOURTHWALL_COLLECTION=all

# --- Commission form email (Resend: free tier is 3,000 emails/month) ---
RESEND_API_KEY=
# Where requests arrive. Leave empty to use the email in src/config/site.ts
COMMISSION_TO_EMAIL=
# Sender. Until you verify a domain in Resend, leave this unset: Resend's test
# sender (onboarding@resend.dev) is used, which only delivers to the email on
# your Resend account.
COMMISSION_FROM_EMAIL=

# --- Cloudflare Turnstile (optional, free) ---
# Without these the form still has a hidden honeypot field and a timing check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
